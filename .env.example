# ==============================================================================
# FinSight AI — Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' in your local development environment:
#   cp .env.example .env
#
# DO NOT commit '.env' to version control (it is excluded via .gitignore).
# Keep database credentials in environment variables or deployment secret manager.
# Never paste real service-role secrets into client-exposed (VITE_) variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Main Database Direct PostgreSQL Connection (Server / Migrations / CLI)
# ------------------------------------------------------------------------------
# DATABASE_URL: The authoritative connection string for the main PostgreSQL database.
# Used by psql, pg_dump, database backup runbooks, and server-side database connections.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Main Supabase Database API Configuration (Public / Safe for Browser Bundles)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: The HTTPS project URL from your main Supabase project (Project Settings > API)
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: The public "anon" API key for client-side Auth and main DB RLS queries.
# Safe to expose in browser bundles; access is strictly constrained by PostgreSQL RLS.
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 3. Main Supabase Server-Only Privileged Key (CRITICAL: NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY: The privileged "service_role" secret key for the main database.
# MUST REMAIN SERVER-ONLY. NEVER prefix with VITE_.
# Used exclusively by the Express backend for server-side audit logging and administrative RPCs.
# If omitted, privileged administrative operations fail closed and are disabled.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. Google Gemini API (Server-Side Financial AI Assistant)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: API key for Fin AI chat, TTS voice, transcription, and Live API streaming.
# Managed on the server; never exposed to browser bundles.
GEMINI_API_KEY=

